# ===============================================================================
# OptiBolt Script: Resource Utilization Reporter (`report_utilization.tcl`)
# ===============================================================================
#
# Author: Tomasz Więcławski & Sebastian Zoń
# Project: OptiBolt Protocol & Evaluation Platform (AGH UST)
#
# DESCRIPTION:
#   Opens the synthesized Design Checkpoint (.dcp) generated by Vivado
#   and outputs comprehensive, detailed resource utilization reports:
#     - results/top_utilization.rpt          (Overall LUTs, FFs, BRAMs, DSPs, I/O)
#     - results/hierarchical_utilization.rpt (Per-module breakdown across hierarchy)
#
# USAGE:
#   From the project root directory in PowerShell:
#     vivado -mode batch -source fpga/scripts/report_utilization.tcl
#   Or using the PowerShell wrapper:
#     .\tools\report_utilization.ps1
#
# PREREQUISITES:
#   Synthesis must have completed at least once (producing `synth_1/top_basys3.dcp`).
# ===============================================================================

set dcp_synth "fpga/build/optibolt_project.runs/synth_1/top_basys3.dcp"
set dcp_impl  "fpga/build/optibolt_project.runs/impl_1/top_basys3_routed.dcp"

# Choose implementation DCP if available, otherwise fall back to synthesis DCP
if {[file exists $dcp_impl]} {
    puts "INFO: Opening routed implementation checkpoint: $dcp_impl"
    open_checkpoint $dcp_impl
} elseif {[file exists $dcp_synth]} {
    puts "INFO: Opening synthesis checkpoint: $dcp_synth"
    open_checkpoint $dcp_synth
} else {
    puts "ERROR: No checkpoint found at $dcp_synth or $dcp_impl."
    puts "Run synthesis first via generate_bitstream.ps1 or quick_synth.ps1"
    exit 1
}

file mkdir results

# Generate detailed reports
puts "INFO: Generating results/top_utilization.rpt ..."
report_utilization -file results/top_utilization.rpt

puts "INFO: Generating results/hierarchical_utilization.rpt ..."
report_utilization -hierarchical -file results/hierarchical_utilization.rpt

puts "SUCCESS: Utilization reports generated in results/"
exit 0

