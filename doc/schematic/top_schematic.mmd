%%{init: {'flowchart': {'curve': 'linear', 'nodeSpacing': 40, 'rankSpacing': 40}}}%%
flowchart LR
    subgraph EXT_IN ["Porty Wejściowe"]
        direction LR
        p_opt_rx(["OptiBolt_rx"]):::port
        p_ps2_in(["PS/2:<br>ps2_clk, ps2_data"]):::port
    end

    subgraph top ["Moduł Główny: top"]
        direction TB
        OCD["optical_carrier_detector<br><i>Detektor Nośnej</i>"]:::inst
        EVAL["top_evaluation<br><i>Blok Ewaluacji</i>"]:::inst
        CDC["optibolt_cdc_bridge<br><i>Mostek CDC</i>"]:::inst
        PROTO["optibolt_controller<br><i>Kontroler Protokołu OptiBolt</i>"]:::inst

        OCD -->|proto_eval_carrier| EVAL
        EVAL -->|eval_proto| CDC
        CDC -->|proto_eval| EVAL
        CDC -->|bridge_proto| PROTO
        PROTO -->|proto_bridge| CDC
    end

    subgraph EXT_OUT ["Porty Wyjściowe"]
        direction LR
        p_vga(["VGA port:<br>vs, hs, r[3:0], g[3:0], b[3:0]"]):::port
        p_seg7(["7segment display:<br>an[3:0], seg[6:0], dp"]):::port
        p_opt_tx(["OptiBolt_tx"]):::port
    end

    %% Połączenia zewnętrzne (z/do modułu top)
    p_opt_rx -->|OptiBolt_rx| top
    p_ps2_in -->|PS/2| top
    top -->|VGA| p_vga
    top -->|7seg| p_seg7
    top -->|OptiBolt_tx| p_opt_tx

    classDef port fill:#e8f5e9,stroke:#2e7d32,stroke-width:1.5px;
